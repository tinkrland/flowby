{
  "name": "flowby-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "the board: tldraw for the spatial layer, react-three-fiber for the 3d elements, @xyflow for the node layer, one camera",
  "scripts": {
    "graph": "../bin/flowby --json graph > public/graph.json",
    "dev": "npm run graph && vite",
    "build": "npm run graph && tsc --noEmit && vite build",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "@xyflow/react": "^12.12.1",
    "motion": "^14.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "tldraw": "2.4.6"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.169.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  }
}
